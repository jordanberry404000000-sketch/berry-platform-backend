{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ledger Parser Status Schema v1.1",
  "type": "object",

  "properties": {
    "subsystem": { "type": "string", "const": "Ledger Parser" },
    "status": {
      "type": "string",
      "enum": ["initializing", "operational", "degraded", "offline"]
    },
    "integrity_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "last_update_utc": { "type": "string", "format": "date-time" },

    "diagnostics": {
      "type": "object",
      "properties": {
        "supported_networks": { "type": "array", "items": { "type": "string" } },
        "parsed_ledger_count_24h": { "type": "integer", "minimum": 0 },
        "last_parsed_height": { "type": ["integer", "null"], "minimum": 0 },

        "api_latency_ms": { "type": "integer", "minimum": 0 },
        "last_error": { "type": ["string", "null"] },
        "heartbeat_count": { "type": "integer", "minimum": 0 },
        "uptime_seconds": { "type": "integer", "minimum": 0 },
        "block_delay_seconds": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": [
        "supported_networks",
        "parsed_ledger_count_24h",
        "last_parsed_height",
        "api_latency_ms",
        "last_error",
        "heartbeat_count",
        "uptime_seconds",
        "block_delay_seconds"
      ]
    }
  },

  "required": [
    "subsystem",
    "status",
    "integrity_fingerprint",
    "last_update_utc",
    "diagnostics"
  ]
}
